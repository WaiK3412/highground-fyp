# Copy to .env and replace every placeholder locally. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
# 1 for local development; unset or 0 in any deployment.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=highground
POSTGRES_USER=highground
POSTGRES_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5433
# Production HTTPS deployments: set DJANGO_DEBUG=0 and real host/origin values.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://highground.example
# Email: leave EMAIL_HOST unset to print messages in the terminal instead.
# Brevo (free tier): EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587, user and
#   SMTP key from Brevo > SMTP & API; DEFAULT_FROM_EMAIL must be a sender
#   address verified in Brevo.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=your Gmail
#   address, EMAIL_HOST_PASSWORD=a 16-character App Password (needs 2-Step
#   Verification), DEFAULT_FROM_EMAIL=HighGround <the same Gmail address>.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=HighGround <you@example.com>
# EMAIL_TIMEOUT=10
# EMAIL_SKIP_DOMAINS=hg.my
# DEMO_RESIDENT_EMAIL=
# DEMO_OFFICER_EMAIL=
